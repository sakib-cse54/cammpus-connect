# CampusConnect server configuration. Copy to server/.env and fill in.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Origin of the React client (CORS + cookie origin)
CLIENT_URL=http://localhost:5173
# Public base URL of this API, used in certificate verification links/QR codes
PUBLIC_URL=http://localhost:5000

# SQLite is the supported engine. Defaults to server/campusconnect.db.
SQLITE_DB_PATH=./campusconnect.db
# Optional: set a postgres:// URL to use the PostgreSQL adapter instead.
# DATABASE_URL=postgres://user:password@localhost:5432/campusconnect_db

# Where generated certificate PDFs are written. Defaults to server/storage/certificates.
CERT_STORAGE_DIR=./storage/certificates

# Secrets: REQUIRED in production, at least 32 characters each.
# In development/test, missing values are replaced by random per-process
# secrets (tokens then do not survive a restart).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
QR_HMAC_SECRET=

# Optional: PEM private key used to sign certificates.
# Ed25519 PKCS#8 PEM (\n escapes allowed). REQUIRED in production.
# Generate with: openssl genpkey -algorithm ed25519
# In development a key is generated once into CERT_SIGNING_KEY_DIR (default ./storage/keys).
# CERT_SIGNING_PRIVATE_KEY=
# CERT_SIGNING_KEY_DIR=./storage/keys
